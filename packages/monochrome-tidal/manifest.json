{
  "name": "monochrome-tidal",
  "displayName": "Monochrome TIDAL",
  "version": "0.2.0",
  "description": "Community metadata and download adapter for a Monochrome TIDAL-compatible JSON service.",
  "homepage": "https://github.com/OreoMuncher45/spotiflac-extensions",
  "type": ["metadata_provider", "download_provider"],
  "minAppVersion": "4.2.3",
  "permissions": {
    "network": [
      "monochrome-api.samidy.com",
      "api.monochrome.tf",
      "wolf.qqdl.site",
      "maus.qqdl.site",
      "vogel.qqdl.site",
      "katze.qqdl.site",
      "hund.qqdl.site",
      "tidal.kinoplus.online",
      "resources.tidal.com",
      "*.tidal.com",
      "*.akamaized.net"
    ],
    "storage": false,
    "file": true
  },
  "qualityOptions": [
    { "id": "LOSSLESS", "label": "Lossless", "description": "Request lossless audio" },
    { "id": "HIGH", "label": "High", "description": "Request high quality audio" },
    { "id": "LOW", "label": "Low", "description": "Request low quality audio" }
  ],
  "searchBehavior": {
    "enabled": true,
    "placeholder": "Search Monochrome...",
    "primary": true,
    "thumbnailRatio": "square",
    "filters": [
      { "id": "track", "label": "Songs", "icon": "music" },
      { "id": "album", "label": "Albums", "icon": "album" }
    ]
  },
  "settings": [
    {
      "key": "preferredApiUrl",
      "label": "Preferred API URL",
      "type": "string",
      "default": "https://monochrome-api.samidy.com",
      "description": "Optional first API candidate. The extension falls back through the official and community API list when it is unavailable. Do not use a UI URL such as monochrome.tf."
    }
  ]
}
